# --- Required for SEO data -------------------------------------------------
# base64 of "login:password" for your DataForSEO account (NOT the dashboard API key):
#   printf '%s' 'LOGIN:PASSWORD' | base64
DATAFORSEO_API_KEY=

# --- Server ----------------------------------------------------------------
PORT=3001
# Bind address. 127.0.0.1 is safe in local_noauth mode; use 0.0.0.0 only behind your own auth or with AUTH_MODE=api_key.
HOST=127.0.0.1
# Public URL used in links returned by the API/MCP (defaults to the request origin).
# PUBLIC_URL=https://seo.example.com
DATABASE_PATH=data/closeseo.db

# --- Auth ------------------------------------------------------------------
# local_noauth : single trusted admin, no login (default; loopback only!)
# api_key      : /api and /mcp require "Authorization: Bearer $CLOSESEO_API_KEY"
AUTH_MODE=local_noauth
# CLOSESEO_API_KEY=use-a-long-random-string

# --- Optional --------------------------------------------------------------
# Multiplier on rank-check cost estimates. 1 = raw DataForSEO price (what you actually pay).
# CREDIT_MARKUP=1
# Seconds between polls of queued rank-check tasks / how long before falling back to live checks.
# RANK_POLL_MS=5000
# RANK_QUEUE_TIMEOUT_MS=600000
# Disable the in-process scheduler (rank checks run only when triggered).
# DISABLE_SCHEDULER=1
# Allow site audits of private/loopback addresses (SSRF protection off!). Testing only.
# ALLOW_PRIVATE_AUDIT_TARGETS=1
# Point at a different DataForSEO-compatible API (used by the test suite).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com

# --- Google Search Console / Analytics (optional, see docs/GOOGLE.md) ------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# At least 32 characters. Encrypts stored Google tokens. Keep it stable.
# CLOSESEO_SECRET=
# Must match the redirect URIs registered in Google Cloud (e.g. http://localhost:3001).
# PUBLIC_URL=http://localhost:3001

# --- Assistant (optional, see docs/ASSISTANT.md) -------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# AGENT_MAX_COST_USD=0.25
# AGENT_MAX_STEPS=8
# AGENT_MAX_PAID_CALLS=6
